    <path
        android:fillColor="#66BB6A"
        android:pathData="M26,6 A2.5,2.5 0 0,0 23.5,8.5 Q23.5,12 26,14 Q28.5,12 28.5,8.5 A2.5,2.5 0 0,0 26,6 Z"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M25,8.5 A1,1 0 1,0 27,8.5 A1,1 0 1,0 25,8.5 Z"/>

    <!-- Checkmark (mid point) -->
    <path
        android:strokeColor="#66BB6A"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M20,16 L22,18 L26,14"/>

