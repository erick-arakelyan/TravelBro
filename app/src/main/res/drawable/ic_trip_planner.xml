        android:fillColor="#EF5350"
        android:pathData="M7,24 A2.5,2.5 0 0,0 4.5,26.5 Q4.5,30 7,32 Q9.5,30 9.5,26.5 A2.5,2.5 0 0,0 7,24 Z"/>
