<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale android:fromXScale="1.0" android:toXScale="0.75"
        android:fromYScale="1.0" android:toYScale="0.75"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="100" android:interpolator="@android:interpolator/accelerate_quad"/>
    <scale android:fromXScale="0.75" android:toXScale="1.15"
        android:fromYScale="0.75" android:toYScale="1.15"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="150" android:startOffset="100"
        android:interpolator="@android:interpolator/decelerate_quad"/>
    <scale android:fromXScale="1.15" android:toXScale="1.0"
        android:fromYScale="1.15" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="100" android:startOffset="250"
        android:interpolator="@android:interpolator/overshoot"/>
</set>
