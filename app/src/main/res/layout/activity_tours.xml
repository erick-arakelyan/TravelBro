<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:paddingTop="36dp"
    android:paddingBottom="16dp"
    android:elevation="4dp">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        app:tint="#111214"
        android:padding="10dp"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Туры и Отели"
        android:textColor="#111214"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <View
        android:layout_width="44dp"
        android:layout_height="44dp"/>
</LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#E5E7EB"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/tab_tours"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✈ Туры"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#111214"
            android:gravity="center"
            android:background="@drawable/bg_tab_active_light"/>

        <TextView
            android:id="@+id/tab_hotels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛏 Отели"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:gravity="center"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/panel_tours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <AutoCompleteTextView
                        android:id="@+id/et_from"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Откуда"
                        android:textColor="#111214"
                        android:textColorHint="#9CA3AF"
                        android:background="@android:color/transparent"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <AutoCompleteTextView
                        android:id="@+id/et_to"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Куда"
                        android:textColor="#111214"
                        android:textColorHint="#9CA3AF"
                        android:background="@android:color/transparent"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_date_from"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="📅 Дата вылета"
                        android:textColor="#111214"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_nights"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="🌙 Ночей"
                        android:textColor="#111214"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_travelers"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="👤 Туристы"
                        android:textColor="#111214"/>

                    <Button
                        android:id="@+id/btn_search_tours"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Найти тур"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_orange_rounded"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/panel_hotels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <AutoCompleteTextView
                        android:id="@+id/et_hotel_dest"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Куда"
                        android:textColor="#111214"
                        android:textColorHint="#9CA3AF"
                        android:background="@android:color/transparent"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_hotel_checkin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="📅 Заезд"
                        android:textColor="#111214"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_hotel_checkout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="📅 Выезд"
                        android:textColor="#111214"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

                    <TextView
                        android:id="@+id/tv_hotel_guests"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="👤 Гости"
                        android:textColor="#111214"/>

                    <Button
                        android:id="@+id/btn_search_hotels"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Найти отель"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_orange_rounded"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>