<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <TextView
            android:id="@+id/pkg_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:textSize="26sp"
            android:gravity="center"
            android:background="@drawable/circle_bg_dim"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/pkg_icon"
            android:layout_marginStart="14dp"
            android:layout_toStartOf="@+id/pkg_price">

            <TextView
                android:id="@+id/pkg_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"/>

            <TextView
                android:id="@+id/pkg_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pkg_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_alignParentEnd="true">

            <TextView
                android:id="@id/pkg_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:gravity="end"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
