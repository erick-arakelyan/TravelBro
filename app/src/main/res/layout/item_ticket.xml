<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardElevation="0dp">

    <!-- Ticket header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="18dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ticket_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/circle_bg_dim"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/ticket_route"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"/>

                <TextView
                    android:id="@+id/ticket_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/ticket_class"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_teal"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ticket_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"/>
        </LinearLayout>

        <!-- Dashed divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/dashed_divider"
            android:layout_marginHorizontal="18dp"/>

        <!-- Barcode row -->
        <TextView
            android:text="▌▌▐ ▌▐▌ ▌▌▐▐ ▌▌ ▐▌▐ ▌▌▐▐"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:paddingVertical="14dp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
