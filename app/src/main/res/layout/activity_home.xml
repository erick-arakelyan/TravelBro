<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".HomeActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="70dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO HEADER -->
            <RelativeLayout
                android:id="@+id/hero_container"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_hero_gradient">

                <View
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_palm_decoration"
                    android:alpha="0.85"/>

                <View
                    android:layout_width="95dp"
                    android:layout_height="130dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_building_decoration"
                    android:alpha="0.7"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim"/>

                <TextView
                    android:id="@+id/tv_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="52dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Welcome, Traveler!"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"/>

                <!-- Search Bar -->
                <LinearLayout
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_below="@id/tv_welcome"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_hint"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Search destinations, flights, and more..."
                        android:textColor="@color/text_hint"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:singleLine="true"/>

                    <ImageView
                        android:id="@+id/iv_mic"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_mic"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/text_hint"/>
                </LinearLayout>

                <!-- Location Chip -->
                <LinearLayout
                    android:id="@+id/location_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_below="@id/search_bar"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_location_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/accent_blue"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Current Location: "
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium"/>

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rome, Italy"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"/>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_hint"/>
                </LinearLayout>

            </RelativeLayout>

            <!-- SERVICES GRID -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_service_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                tools:listitem="@layout/item_service_card"
                tools:itemCount="8"/>

            <!-- LAST ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <!-- Offline Maps Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_offline_maps"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/card_maps_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_maps_icon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_offline_maps"
                            app:tint="@color/accent_map"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iv_maps_icon"
                            android:layout_marginStart="10dp"
                            android:layout_alignTop="@id/iv_maps_icon"
                            android:text="Offline Maps"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/montserrat_bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iv_maps_icon"
                            android:layout_marginStart="10dp"
                            android:layout_alignBottom="@id/iv_maps_icon"
                            android:text="Use Maps Without Internet"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:fontFamily="@font/montserrat_regular"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Active Traveler Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_active_traveler"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/card_traveler_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_traveler_icon"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_active_traveler"
                            app:tint="@color/accent_gold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="6dp"
                            android:text="Active Traveler\nStatus"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/montserrat_bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:text="Collect Bonuses &amp; Benefits"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:fontFamily="@font/montserrat_regular"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:background="@color/nav_bg"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemBackground="@drawable/bottom_nav_item_bg"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>