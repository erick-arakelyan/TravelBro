<?xml version="1.0" encoding="utf-8"?>
<!--
    item_service_card.xml
    Individual card item for the service grid.
    Layout: square card with icon (top-left), title, subtitle, accent dot.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <!-- Card wrapper with elevation -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1A3A5C"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <!-- Icon (top-left area) -->
            <ImageView
                android:id="@+id/iv_card_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"/>

            <!-- Accent indicator dot (top-right) -->
            <View
                android:id="@+id/accent_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/shape_circle"/>

            <!-- Card Title -->
            <TextView
                android:id="@+id/tv_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_card_icon"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <!-- Card Subtitle -->
            <TextView
                android:id="@+id/tv_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_card_title"
                android:layout_marginTop="2dp"
                android:textColor="#7A9DC0"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_regular"
                android:singleLine="true"
                android:ellipsize="end"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
