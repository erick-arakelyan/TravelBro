<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TravelBro" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.TravelBro.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/splash_start</item>
        <item name="android:navigationBarColor">@color/splash_end</item>
    </style>
    <style name="LanguageBottomSheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Добавь эти стили в res/values/themes.xml или styles.xml -->

    <!-- Тёмный DatePicker -->
    <style name="DarkDatePicker" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">#FF6D00</item>
        <item name="android:datePickerStyle">@style/DarkDatePickerStyle</item>
        <item name="android:windowBackground">@drawable/autocomplete_dropdown_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E9099</item>
        <item name="android:background">#1E2025</item>
    </style>

    <style name="DarkDatePickerStyle" parent="android:Widget.DatePicker">
        <item name="android:calendarTextColor">#FFFFFF</item>
        <item name="android:headerBackground">#FF6D00</item>
    </style>

    <!-- Тёмный AlertDialog для выбора класса -->
    <style name="DarkAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#FF6D00</item>
        <item name="android:background">#1E2025</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E9099</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>
